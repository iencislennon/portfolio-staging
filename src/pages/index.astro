---
import { u } from "../lib/url";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";

const projects = (await getCollection("projects", (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateModified: site.updated,
  mainEntity: {
    "@type": "Person",
    name: site.name,
    jobTitle: site.title,
    description: site.description,
    address: { "@type": "PostalAddress", addressLocality: "Almaty", addressCountry: "KZ" },
    sameAs: [site.github, site.linkedin],
    email: `mailto:${site.email}`,
  },
};
---
<Base title={site.title} description={site.description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.hero.h1}</h1>
      <p class="body">{site.hero.body}</p>
      <div class="cta">
        <a class="btn btn-primary" href={u("/work/")}>View selected work</a>
        <a class="btn btn-secondary" href={u("/resume/")}>Résumé</a>
        <a class="textlink" href="#contact">Contact me</a>
      </div>
      <p class="status"><span class="chip" data-tone="live">Open</span> {site.status}</p>
    </div>
  </section>

  <section class="proof" aria-label="Proof">
    <div class="container">
      <ul>{site.proof.map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>

  <section class="section" aria-labelledby="work-h">
    <div class="container">
      <p class="eyebrow">Featured work</p>
      <h2 id="work-h">Four projects, each with its evidence</h2>
      <div class="grid">
        {projects.map((p, i) => <div class={`cell c${i}`}><ProjectCard project={p} /></div>)}
      </div>
      <p class="more"><a href={u("/work/")}>All work</a></p>
    </div>
  </section>

  <section class="section alt" aria-labelledby="range-h">
    <div class="container">
      <p class="eyebrow">Engineering range</p>
      <h2 id="range-h">What I work on</h2>
      <dl class="range">
        {site.range.map((r) => (<div><dt>{r.area}</dt><dd>{r.detail}</dd></div>))}
      </dl>
    </div>
  </section>

  {site.experience.length > 0 && (
    <section class="section" id="experience" aria-labelledby="exp-h">
      <div class="container">
        <p class="eyebrow">Experience</p>
        <h2 id="exp-h">Experience and research</h2>
        <ol class="timeline">{site.experience.map((e) => <li><span class="meta">{e.period}</span><strong>{e.role}</strong>, {e.org}{e.note && <p>{e.note}</p>}</li>)}</ol>
      </div>
    </section>
  )}

  {site.recognition.length > 0 && (
    <section class="section alt" aria-labelledby="rec-h">
      <div class="container">
        <p class="eyebrow">Selected recognition</p>
        <h2 id="rec-h">Recognition</h2>
        <ul class="plain">{site.recognition.map((r) => <li><strong>{r.title}</strong> {r.detail}</li>)}</ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="about-h">
    <div class="container read">
      <p class="eyebrow">About</p>
      <h2 id="about-h">Evidence before claims</h2>
      <p>I am an AI/ML engineer based in Almaty. I like projects where a result can be checked: a benchmark with a stated baseline, a forecast evaluated on later data, an agent system whose coordination rules have tests. This site says what each project measured, what failed and what is still unknown.</p>
      <p><a href={u("/about/")}>More about me</a></p>
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="contact-h">
    <div class="container read">
      <h2 id="contact-h">Let's talk about internships and research</h2>
      <p>{site.status}. Email is the fastest way to reach me.</p>
      <p><a class="btn btn-primary" href={`mailto:${site.email}`}>Email me</a></p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 72px 56px; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; background-position: -1px -1px; }
  :global(:root[data-theme="dark"]) .hero { background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); }
  .hero .container { background: linear-gradient(var(--paper), var(--paper)); padding-block: 8px; }
  h1 { font-size: clamp(40px, 11vw, 56px); line-height: 1; letter-spacing: -0.02em; max-width: 16ch; margin-bottom: 24px; }
  .body { font-size: 1.1875rem; color: var(--ink-soft); max-width: 60ch; }
  .cta { display: flex; flex-direction: column; gap: 12px; margin-block: 32px 24px; align-items: stretch; }
  .textlink { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; font-weight: 600; }
  .status { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--ink-soft); font-size: 0.9375rem; margin: 0; }
  .proof { border-block: 1px solid var(--line); background: var(--surface); }
  .proof ul { list-style: none; margin: 0; padding: 24px 0; display: grid; gap: 12px; }
  .proof li { font-weight: 500; color: var(--ink); }
  h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 40px; max-width: 24ch; }
  .grid { display: grid; gap: 24px; }
  .more { margin-top: 32px; }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .range { display: grid; gap: 24px; margin: 0; }
  .range dt { font: 700 1.125rem/1.3 var(--font-head); margin-bottom: 4px; }
  .range dd { margin: 0; color: var(--ink-soft); }
  .timeline { padding-left: 20px; display: grid; gap: 20px; }
  .timeline .meta { display: block; margin-bottom: 2px; }
  .plain { padding-left: 20px; }
  .cta-band h2 { margin-bottom: 16px; }
  @media (min-width: 640px) {
    .cta { flex-direction: row; align-items: center; flex-wrap: wrap; }
    .hero { padding-block: 112px 80px; }
    .range { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    h1 { font-size: clamp(56px, 6vw, 72px); line-height: 0.98; }
    .proof ul { grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .grid { grid-template-columns: repeat(12, 1fr); gap: 24px; }
    .c0 { grid-column: span 7; } .c1 { grid-column: span 5; } .c2 { grid-column: span 5; } .c3 { grid-column: span 7; }
    .range { grid-template-columns: repeat(4, 1fr); }
  }
</style>
