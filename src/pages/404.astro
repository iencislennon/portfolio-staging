---
import { u } from "../lib/url";
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist." path="/404/">
  <section class="section">
    <div class="container read">
      <p class="eyebrow">404</p>
      <h1>This page is not here</h1>
      <p>The link may be old or mistyped. These are the places that exist:</p>
      <ul>
        <li><a href={u("/")}>Home</a></li>
        <li><a href={u("/work/")}>Selected work</a></li>
        <li><a href={u("/about/")}>About</a></li>
        <li><a href={u("/resume/")}>Résumé</a></li>
      </ul>
    </div>
  </section>
</Base>
<style>h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin-bottom: 16px; } li { margin-bottom: 8px; }</style>
