---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
// The download button appears only when the PDF has actually been added to /public/resume.
const hasPdf = existsSync(new URL(`../../public${site.resumePdf}`, import.meta.url));
---
<Base title="Résumé" description="Résumé of Ansar Tleubayev, AI/ML engineer." path="/resume/">
  <section class="section">
    <div class="container read">
      <p class="eyebrow">Résumé</p>
      <h1>Résumé</h1>
      {hasPdf
        ? <p><a class="btn btn-primary" href={site.resumePdf} download>Download résumé (PDF)</a></p>
        : <p>The PDF résumé is not published on this site yet. Please email me for the current version, or see my LinkedIn profile.</p>}
      <p><a class="btn btn-secondary" href={`mailto:${site.email}?subject=R%C3%A9sum%C3%A9%20request`}>Email me</a> <a class="btn btn-secondary" href={site.linkedin} rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span> ↗</a></p>
    </div>
  </section>
</Base>
<style>
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin-bottom: 24px; }
  p:last-child { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
