---
import { u, stripBase } from "../lib/url";
import { site } from "../data/site";
const path = stripBase(Astro.url.pathname);
const nav = [
  { href: u("/work/"), label: "Work", active: path.startsWith("/work") },
  ...(site.experience.length ? [{ href: u("/about/#experience"), label: "Experience", active: false }] : []),
  { href: u("/about/"), label: "About", active: path.startsWith("/about") },
  { href: "#contact", label: "Contact", active: false },
  { href: u("/resume/"), label: "Résumé", active: path.startsWith("/resume") },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={u("/")} aria-label={`${site.name} — home`}>{site.initials}</a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={n.active ? "page" : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <button id="theme-toggle" class="theme" type="button" aria-label="Theme: system. Activate to change.">
      <span aria-hidden="true">◐</span><span class="sr-only">Toggle theme</span>
    </button>
  </div>
</header>
<script>
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");
  const order = ["system", "light", "dark"] as const;
  const read = () => { try { return localStorage.getItem("theme") || "system"; } catch { return "system"; } };
  const apply = (v: string) => {
    if (v === "system") delete root.dataset.theme; else root.dataset.theme = v;
    btn?.setAttribute("aria-label", `Theme: ${v}. Activate to change.`);
    try { v === "system" ? localStorage.removeItem("theme") : localStorage.setItem("theme", v); } catch {}
  };
  apply(read());
  btn?.addEventListener("click", () => {
    const next = order[(order.indexOf(read() as (typeof order)[number]) + 1) % order.length];
    apply(next);
  });
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--paper) 92%, transparent); border-bottom: 1px solid var(--line); backdrop-filter: blur(8px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 64px; }
  .brand { font: 800 1.125rem/1 var(--font-head); color: var(--ink); text-decoration: none; min-width: 44px; min-height: 44px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  nav ul { display: flex; flex-wrap: wrap; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; color: var(--ink-soft); text-decoration: none; font-weight: 500; font-size: 0.9375rem; border-radius: 8px; }
  nav a:hover, nav a[aria-current="page"] { color: var(--primary); }
  nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 6px; }
  .theme { min-width: 44px; min-height: 44px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; font-size: 1.1rem; }
  .theme:hover { border-color: var(--primary); }
  @media (max-width: 479px) { nav a { padding: 0 6px; font-size: 0.875rem; } }
</style>
