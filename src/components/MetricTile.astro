---
const { value, label, context, source, sourceUrl } = Astro.props as { value: string; label: string; context: string; source: string; sourceUrl?: string };
---
<div class="tile">
  <p class="value">{value}</p>
  <p class="label">{label}</p>
  <p class="ctx">{context}</p>
  <p class="src meta">Source: {sourceUrl ? <a href={sourceUrl} rel="noopener noreferrer">{source}</a> : source}</p>
</div>
<style>
  .tile { border: 1px solid var(--line); border-radius: 16px; padding: 20px; background: var(--surface); }
  .tile p { margin: 0 0 6px; }
  .value { font: 800 clamp(1.75rem, 4vw, 2.5rem)/1.05 var(--font-head); color: var(--ink); letter-spacing: -0.02em; }
  .label { font-weight: 600; color: var(--ink); }
  .ctx { font-size: 0.9375rem; color: var(--ink-soft); line-height: 1.5; }
  .src { margin-top: 10px; overflow-wrap: anywhere; }
</style>
