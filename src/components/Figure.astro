---
// All figures are inline SVG drawn from verified source numbers (see each case study's Sources).
// Colours use theme tokens so both themes are intentional.
const { id, alt } = Astro.props as { id: string; alt: string };
const uid = `f-${id}`;
---
<svg viewBox="0 0 640 360" role="img" aria-labelledby={`${uid}-t`} xmlns="http://www.w3.org/2000/svg" font-family="Inter Variable, system-ui, sans-serif">
  <title id={`${uid}-t`}>{alt}</title>
  <defs>
    <pattern id={`${uid}-g`} width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="var(--line)" stroke-width="1" /></pattern>
    <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="var(--muted)" /></marker>
  </defs>
  <rect width="640" height="360" fill="var(--paper)" />
  <rect width="640" height="360" fill={`url(#${uid}-g)`} opacity="0.7" />

  {id === "cover-triton" && (<>
    <text x="32" y="48" font-size="22" font-weight="700" fill="var(--ink)">Whole command, seconds</text>
    <text x="32" y="74" font-size="14" fill="var(--muted)">Tesla T4 · Qwen2.5-1.5B LoRA · lower is better</text>
    <line x1="150" y1="110" x2="150" y2="320" stroke="var(--muted)" />
    <rect x="150" y="116" width={83.25 * 4} height="64" rx="8" fill="var(--muted)" opacity="0.55" />
    <text x="160" y="156" font-size="20" font-weight="600" fill="var(--ink)">83.25 s</text>
    <text x="32" y="156" font-size="18" fill="var(--ink-soft)">Base</text>
    <rect x="150" y="206" width={59.66 * 4} height="64" rx="8" fill="var(--primary)" />
    <text x="160" y="246" font-size="20" font-weight="700" fill="var(--primary-ink)">59.66 s</text>
    <text x="32" y="246" font-size="18" fill="var(--ink)">Solution</text>
    <text x="150" y="324" font-size="14" fill="var(--muted)">Axis starts at 0 · speedup 1.3954×</text>
  </>)}

  {id === "cover-crisisnet" && (<>
    {["Farmer", "Logistics", "Energy", "Market"].map((n, i) => (<>
      <rect x="40" y={40 + i * 66} width="150" height="48" rx="10" fill="var(--surface)" stroke="var(--cyan)" stroke-width="2" />
      <text x="115" y={70 + i * 66} text-anchor="middle" font-size="18" font-weight="600" fill="var(--ink)">{n}</text>
      <line x1="190" y1={64 + i * 66} x2="262" y2="170" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />
    </>))}
    <rect x="266" y="126" width="140" height="88" rx="14" fill="var(--surface)" stroke="var(--emerald)" stroke-width="2" />
    <text x="336" y="164" text-anchor="middle" font-size="18" font-weight="700" fill="var(--ink)">Band Room</text>
    <text x="336" y="190" text-anchor="middle" font-size="14" fill="var(--muted)">conflict checks</text>
    <line x1="406" y1="170" x2="450" y2="170" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />
    <rect x="454" y="136" width="150" height="68" rx="12" fill="var(--primary)" />
    <text x="529" y="176" text-anchor="middle" font-size="18" font-weight="700" fill="var(--primary-ink)">Regulator</text>
    <text x="529" y="248" text-anchor="middle" font-size="14" fill="var(--ink-soft)">escalates to a human</text>
    <text x="529" y="268" text-anchor="middle" font-size="14" fill="var(--ink-soft)">when confidence is low</text>
  </>)}

  {id === "cover-pm25" && (<>
    <text x="32" y="48" font-size="22" font-weight="700" fill="var(--ink)">Chronological holdout</text>
    <text x="32" y="74" font-size="14" fill="var(--muted)">Every test row is later than every training row</text>
    <rect x="32" y="130" width="400" height="64" rx="10" fill="var(--primary)" />
    <text x="232" y="170" text-anchor="middle" font-size="20" font-weight="700" fill="var(--primary-ink)">Train (earlier dates)</text>
    <rect x="440" y="130" width="168" height="64" rx="10" fill="var(--amber)" />
    <text x="524" y="170" text-anchor="middle" font-size="20" font-weight="700" fill="var(--paper)">Test (later)</text>
    <line x1="32" y1="230" x2="608" y2="230" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />
    <text x="32" y="260" font-size="16" fill="var(--ink-soft)">time</text>
    <text x="32" y="320" font-size="14" fill="var(--muted)">Lag features use only past values · target encoding fit on train only</text>
  </>)}

  {id === "cover-water" && (<>
    <text x="32" y="48" font-size="22" font-weight="700" fill="var(--ink)">Internal fit vs independent check</text>
    <text x="32" y="74" font-size="14" fill="var(--muted)">R² · higher is better · axis 0 to 1</text>
    <line x1="150" y1="110" x2="150" y2="320" stroke="var(--muted)" />
    <rect x="150" y="116" width={0.9464 * 440} height="64" rx="8" fill="var(--muted)" opacity="0.55" />
    <text x="160" y="156" font-size="20" font-weight="600" fill="var(--ink)">0.946</text>
    <text x="32" y="148" font-size="16" fill="var(--ink-soft)">Model test</text>
    <text x="32" y="168" font-size="12" fill="var(--muted)">(uses lag feature)</text>
    <rect x="150" y="206" width={0.349 * 440} height="64" rx="8" fill="var(--cyan)" />
    <text x="160" y="246" font-size="20" font-weight="700" fill="var(--paper)">0.349</text>
    <text x="32" y="238" font-size="16" fill="var(--ink)">DAHITI</text>
    <text x="32" y="258" font-size="12" fill="var(--muted)">(independent)</text>
    <text x="150" y="324" font-size="14" fill="var(--muted)">Pearson r = 0.67 against Lake Balkhash levels, n = 221</text>
  </>)}

  {id === "arch-triton" && (<>
    {[["Soup 0.77 task", "NF4 + LoRA r16"], ["Padding removal", "skip pad tokens"], ["Triton kernels", "own-kernel share ≥ 5%"], ["Smaller saved", "activations"]].map(([a, b], i) => (<>
      <rect x={20 + i * 156} y="120" width="136" height="96" rx="12" fill="var(--surface)" stroke={i === 2 ? "var(--primary)" : "var(--line)"} stroke-width="2" />
      <text x={88 + i * 156} y="160" text-anchor="middle" font-size="16" font-weight="700" fill="var(--ink)">{a}</text>
      <text x={88 + i * 156} y="186" text-anchor="middle" font-size="13" fill="var(--muted)">{b}</text>
      {i < 3 && <line x1={156 + i * 156} y1="168" x2={176 + i * 156} y2="168" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />}
    </>))}
    <rect x="20" y="256" width="600" height="56" rx="12" fill="var(--surface)" stroke="var(--cyan)" stroke-width="2" />
    <text x="320" y="290" text-anchor="middle" font-size="16" font-weight="600" fill="var(--ink)">Paired ABBA harness: base → solution → solution → base</text>
    <text x="320" y="80" text-anchor="middle" font-size="14" fill="var(--muted)">Training path (top) · measurement path (bottom)</text>
  </>)}

  {id === "arch-crisisnet" && (<>
    <rect x="20" y="30" width="120" height="56" rx="10" fill="var(--surface)" stroke="var(--line)" stroke-width="2" /><text x="80" y="64" text-anchor="middle" font-size="15" font-weight="600" fill="var(--ink)">React UI</text>
    <line x1="140" y1="58" x2="180" y2="58" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} /><text x="160" y="46" text-anchor="middle" font-size="11" fill="var(--muted)">WS / REST</text>
    <rect x="184" y="30" width="170" height="56" rx="10" fill="var(--surface)" stroke="var(--cyan)" stroke-width="2" /><text x="269" y="64" text-anchor="middle" font-size="15" font-weight="600" fill="var(--ink)">FastAPI orchestrator</text>
    {["Farmer", "Logistics", "Energy", "Market"].map((n, i) => (<>
      <line x1="269" y1="86" x2={80 + i * 150} y2="140" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />
      <rect x={20 + i * 150} y="144" width="120" height="48" rx="10" fill="var(--surface)" stroke="var(--cyan)" stroke-width="2" />
      <text x={80 + i * 150} y="174" text-anchor="middle" font-size="15" font-weight="600" fill="var(--ink)">{n}</text>
      <line x1={80 + i * 150} y1="192" x2="320" y2="236" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />
    </>))}
    <rect x="220" y="240" width="200" height="56" rx="12" fill="var(--surface)" stroke="var(--emerald)" stroke-width="2" /><text x="320" y="264" text-anchor="middle" font-size="15" font-weight="700" fill="var(--ink)">Band Room coordinator</text><text x="320" y="283" text-anchor="middle" font-size="12" fill="var(--muted)">4 conflict rules · audit trail</text>
    <line x1="420" y1="268" x2="470" y2="268" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />
    <rect x="474" y="240" width="146" height="56" rx="12" fill="var(--primary)" /><text x="547" y="264" text-anchor="middle" font-size="15" font-weight="700" fill="var(--primary-ink)">Regulator</text><text x="547" y="283" text-anchor="middle" font-size="12" fill="var(--primary-ink)">policy + escalate flag</text>
    <text x="320" y="338" text-anchor="middle" font-size="12" fill="var(--muted)">Output: Markdown / JSON / PDF report</text>
  </>)}

  {id === "arch-pm25" && (<>
    {[["OpenAQ v3", "daily PM2.5"], ["Sort by date", "per station"], ["Lag + rolling", "past values only"], ["Date cutoff", "train | test"], ["RF / GBM / Ridge", "fit on train"]].map(([a, b], i) => (<>
      <rect x={14 + i * 124} y="130" width="108" height="92" rx="12" fill="var(--surface)" stroke={i === 3 ? "var(--amber)" : "var(--line)"} stroke-width="2" />
      <text x={68 + i * 124} y="168" text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink)">{a}</text>
      <text x={68 + i * 124} y="190" text-anchor="middle" font-size="11" fill="var(--muted)">{b}</text>
      {i < 4 && <line x1={122 + i * 124} y1="176" x2={136 + i * 124} y2="176" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />}
    </>))}
    <text x="320" y="290" text-anchor="middle" font-size="13" fill="var(--muted)">Target encoding for station is computed from training rows only</text>
  </>)}

  {id === "arch-water" && (<>
    {[["GRACE / GRACE-FO", "~55 km water storage"], ["Satellite features", "precip · ET · NDVI"], ["Random Forest", "downscale to 500 m grid"], ["Dashboard", "map + time series"]].map(([a, b], i) => (<>
      <rect x={20 + i * 156} y="100" width="136" height="92" rx="12" fill="var(--surface)" stroke="var(--cyan)" stroke-width="2" />
      <text x={88 + i * 156} y="140" text-anchor="middle" font-size="14" font-weight="700" fill="var(--ink)">{a}</text>
      <text x={88 + i * 156} y="164" text-anchor="middle" font-size="11" fill="var(--muted)">{b}</text>
      {i < 3 && <line x1={156 + i * 156} y1="146" x2={176 + i * 156} y2="146" stroke="var(--muted)" marker-end={`url(#${uid}-a)`} />}
    </>))}
    <rect x="176" y="256" width="288" height="56" rx="12" fill="var(--surface)" stroke="var(--emerald)" stroke-width="2" />
    <text x="320" y="280" text-anchor="middle" font-size="14" font-weight="700" fill="var(--ink)">DAHITI altimetry (Lake Balkhash)</text>
    <text x="320" y="300" text-anchor="middle" font-size="12" fill="var(--muted)">independent validation · 2-month shift</text>
    <line x1="320" y1="256" x2="320" y2="196" stroke="var(--muted)" stroke-dasharray="4 4" marker-end={`url(#${uid}-a)`} />
  </>)}
</svg>
