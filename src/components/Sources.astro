---
const { items } = Astro.props as { items: string[] };
---
<aside class="sources" aria-label="Sources">
  <p class="meta">Sources</p>
  <ul>{items.map((i) => <li>{i}</li>)}</ul>
</aside>
<style>
  .sources { border-left: 3px solid var(--line); padding: 4px 0 4px 16px; margin: 24px 0; }
  .sources p { margin: 0 0 4px; }
  .sources ul { overflow-wrap: anywhere; margin: 0; padding-left: 18px; color: var(--ink-soft); font-size: 0.9375rem; }
</style>
